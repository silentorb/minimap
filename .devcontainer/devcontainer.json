{
    "name": "minimap",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "8.0",
            "dotnetRuntimeVersions": "8.0"
        }
    },
    "containerEnv": {
        "GODOT_BIN": "/opt/godot/Godot_v4.6-stable_mono_linux.x86_64"
    },
    "mounts": [
    ],
    "customizations": {
        "vscode": {
            "extensions": [],
            "settings": {
                "files.eol": "\n"
            }
        }
    }
}
