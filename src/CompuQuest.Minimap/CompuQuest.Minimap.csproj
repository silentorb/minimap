<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CompuQuest.Minimap</RootNamespace>
    <AssemblyName>CompuQuest.Minimap</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <_RepoExtensionsDir>$(MSBuildThisFileDirectory)..\..\extensions</_RepoExtensionsDir>
    <_ExtensionContentDir>$(_RepoExtensionsDir)\$(AssemblyName)</_ExtensionContentDir>
    <_ExtensionContentStamp>$(_ExtensionContentDir)\.content.stamp</_ExtensionContentStamp>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Minimap.Extensive/Minimap.Extensive.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="../Minimap.Simulation/Minimap.Simulation.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="config\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <_ExtensionConfigFiles Include="$(MSBuildThisFileDirectory)config\**\*.json" />
  </ItemGroup>
  <!--
    Mirror (wipe + copy) gitignored extensions/$(AssemblyName)/ so pull survivors
    (e.g. retired plant_vegetable.json on a Windows clone) cannot linger beside new content.
    Inputs/Outputs ensure JSON add/remove/rename re-runs the target even when C# is up-to-date.
  -->
  <Target Name="CopyExtensionToRepoExtensions"
          AfterTargets="Build"
          Inputs="$(TargetPath);@(_ExtensionConfigFiles)"
          Outputs="$(MSBuildThisFileDirectory)..\..\extensions\$(AssemblyName).dll;$(_ExtensionContentStamp)">
    <MakeDir Directories="$(_RepoExtensionsDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(_RepoExtensionsDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(_RepoExtensionsDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <RemoveDir Directories="$(_ExtensionContentDir)" Condition="Exists('$(_ExtensionContentDir)')" />
    <MakeDir Directories="$(_ExtensionContentDir)" />
    <Copy SourceFiles="@(_ExtensionConfigFiles)"
          DestinationFiles="@(_ExtensionConfigFiles->'$(_ExtensionContentDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <WriteLinesToFile File="$(_ExtensionContentStamp)"
                      Lines="$([System.DateTime]::UtcNow.ToString('o'))"
                      Overwrite="true" />
  </Target>
</Project>
